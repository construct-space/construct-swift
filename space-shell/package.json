    "async-validator": "^4.2.5",
    "axios": "^1.17.0",
    "change-case": "^5.4.4",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.3",
    "dompurify": "^3.4.8",
    "drauu": "^1.0.0",
    "focus-trap": "^8.2.1",
    "fuse.js": "^7.3.0",
    "idb-keyval": "^6.2.4",
    "jwt-decode": "^4.0.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.5",
    "nprogress": "^0.2.0",
    "pinia": "3.0.4",
    "qrcode": "^1.5.4",
